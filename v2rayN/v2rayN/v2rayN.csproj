<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
		<UseWPF>true</UseWPF>
		<AssemblyName>VaKoLink</AssemblyName>
		<RootNamespace>v2rayN</RootNamespace>
		<Product>VaKoLink</Product>
		<ApplicationIcon>Resources\VaKoLink.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CETCompat>false</CETCompat>
		<VaKoLinkRevision>21</VaKoLinkRevision>
		<VaKoLinkVersion>1.$(VaKoLinkRevision)</VaKoLinkVersion>
		<FileVersion>$(VaKoLinkVersion).0.0</FileVersion>
		<InformationalVersion>$(VaKoLinkVersion)</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MaterialDesignThemes" />
		<PackageReference Include="H.NotifyIcon.Wpf" />
		<PackageReference Include="ReactiveUI.SourceGenerators">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="ReactiveUI.WPF" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="app.manifest" />
		<EmbeddedResource Include="Resources\v2rayN.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<Resource Include="Resources\NotifyIcon1.ico" />
		<Resource Include="Resources\NotifyIcon2.ico" />
		<Resource Include="Resources\NotifyIcon3.ico" />
		<Resource Include="Resources\NotifyIcon4.ico" />
		<Resource Include="Resources\VaKoLinkProxy.ico" />
		<Resource Include="Resources\v2rayN.ico" />
		<Resource Include="Resources\VaKoLink.ico;Resources\VaKoLinkTray.ico" />
		<AssemblyMetadata Include="VaKoLinkRevision" Value="$(VaKoLinkRevision)" />
		<AssemblyMetadata Include="VaKoLinkVersion" Value="$(VaKoLinkVersion)" />
		<Compile Include="..\Update\UpdatePackage.cs" Link="Update\UpdatePackage.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(VaKoLinkTransportSourceRoot)' != ''">
		<DefineConstants>$(DefineConstants);VAKOLINK_TRANSPORT</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(VaKoLinkTransportSourceRoot)' != ''">
		<ProjectReference Include="$(VaKoLinkTransportSourceRoot)\src\VakoLink.AntiDpi.Windows\VakoLink.AntiDpi.Windows.csproj" />
		<Compile Include="$(VaKoLinkTransportSourceRoot)\src\VakoLink.AionTransport.Proxy\UserTransportRuntime.cs" Link="Transport\UserTransportRuntime.cs" />
		<Compile Include="$(VaKoLinkTransportSourceRoot)\src\VakoLink.AionTransport.Proxy\GameInstall.cs" Link="Transport\GameInstall.cs" />
		<Content Include="$(VaKoLinkTransportSourceRoot)\tools\Discover-LocalProxy.ps1;$(VaKoLinkTransportSourceRoot)\tools\ProxyNetworkState.ps1"
		         Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
		         CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Include="$(VaKoLinkTransportCore)" Link="core\sing-box.exe" CopyToOutputDirectory="PreserveNewest"
		         CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

</Project>
