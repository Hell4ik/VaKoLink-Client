<Window
    x:Class="v2rayN.Views.WhatsNewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource PultCard}"
    Foreground="{DynamicResource PultText}"
    Width="540"
    MaxHeight="620"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Icon="/Resources/VaKoLink.ico">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/PultStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="24,20">
        <TextBlock x:Name="heading" DockPanel.Dock="Top" Margin="0,0,0,16" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button DockPanel.Dock="Bottom" Margin="0,16,0,0" HorizontalAlignment="Right" MinWidth="104"
                Style="{StaticResource PultButton}" IsDefault="True" Content="Понятно" Click="Dismiss_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="releases">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,10,13">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
