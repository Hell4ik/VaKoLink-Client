<Window
    x:Class="v2rayN.Views.WhatsNewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource PultCard}"
    Foreground="{DynamicResource PultText}"
    Width="540"
    MaxHeight="500"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Icon="/Resources/VaKoLink.ico">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/PultStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="24,20">
        <TextBlock x:Name="heading" DockPanel.Dock="Top" Margin="0,0,0,16" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button DockPanel.Dock="Bottom" Margin="0,16,0,0" HorizontalAlignment="Right" MinWidth="104"
                Style="{StaticResource PultButton}" IsDefault="True" Content="Понятно" Click="Dismiss_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"><Run FontWeight="SemiBold">Добавлено.</Run> В верхней панели показаны срок действия и общий трафик конфигурации.</TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">Исправлено.</Run> Устранён сбой при закрытии старого клиента во время установки. При следующем запуске VaKoLink показывает причину ошибки установки.</TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
