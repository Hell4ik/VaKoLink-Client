<Window
    x:Class="v2rayN.Views.WhatsNewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource PultCard}"
    Foreground="{DynamicResource PultText}"
    Width="540"
    MaxHeight="500"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Icon="/Resources/VaKoLink.ico">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/PultStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="24,20">
        <TextBlock x:Name="heading" DockPanel.Dock="Top" Margin="0,0,0,16" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button DockPanel.Dock="Bottom" Margin="0,16,0,0" HorizontalAlignment="Right" MinWidth="104"
                Style="{StaticResource PultButton}" IsDefault="True" Content="Понятно" Click="Dismiss_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"><Run FontWeight="SemiBold">1. Обновлён заголовок окна.</Run> Теперь в нём отображаются название VaKoLink, версия приложения и архитектура.</TextBlock>
                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"><Run FontWeight="SemiBold">2. Единая проверка обновлений.</Run> VaKoLink и компоненты проверяются одной кнопкой, а результаты выводятся в общей сводке. Новая версия приложения скачивается автоматически.</TextBlock>
                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"><Run FontWeight="SemiBold">3. Установка в один клик.</Run> После нажатия «Установить» клиент сам отключает VPN и Transport, устанавливает обновление и перезапускается.</TextBlock>
                <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold">4. Восстановление подключения.</Run> Если VPN был активен до установки, после перезапуска клиент подключается к прежней ноде в том же режиме. Transport запускается вручную.</TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
