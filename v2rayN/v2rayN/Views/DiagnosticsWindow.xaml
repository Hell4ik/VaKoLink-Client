<Window x:Class="v2rayN.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Resources/VaKoLink.ico"
        Background="{DynamicResource PultCard}" Foreground="{DynamicResource PultText}">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/PultStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="22,18">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Диагностика" />
        <TextBlock Margin="0,2,0,12" Foreground="{DynamicResource PultMuted}" Text="Последние состояния" />
        <ItemsControl x:Name="rows">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PultOutline}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="104" Text="{Binding Name}" />
                            <TextBlock Text="{Binding State}" TextAlignment="Right" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PultMuted}" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="selectedIncident" Margin="0,8,0,6" TextWrapping="Wrap" Foreground="{DynamicResource PultMuted}" />
        <WrapPanel>
            <Button Margin="0,0,8,4" Style="{StaticResource PultButton}" Content="Открыть папку журналов" Click="OpenLogs_Click" />
            <Button x:Name="saveIncident" Margin="0,0,0,4" Style="{StaticResource PultButton}"
                    Content="Сохранить отчёт Transport" Click="SaveIncident_Click" />
        </WrapPanel>
        <Expander Margin="0,8,0,0" Header="Хранение журналов">
            <StackPanel>
                <TextBlock Text="Интервал ротации, минуты (1–1440)" />
                <TextBox x:Name="rotationMinutes" />
                <TextBlock Text="Обычные журналы, часы (1–168)" />
                <TextBox x:Name="retentionHours" />
                <TextBlock Text="Отчёты Transport, дни (1–30)" />
                <TextBox x:Name="transportDays" />
                <Button x:Name="saveSettings" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Style="{StaticResource PultButton}" Content="Сохранить настройки" Click="SaveSettings_Click" />
            </StackPanel>
        </Expander>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="copyReport" Margin="0,0,8,0" Style="{StaticResource PultButton}"
                    Content="Скопировать отчёт" Click="CopyReport_Click" />
            <Button IsCancel="True" Style="{StaticResource PultButton}" Content="Закрыть" />
        </StackPanel>
    </StackPanel>
</Window>
