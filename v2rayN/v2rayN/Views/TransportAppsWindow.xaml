<Window x:Class="v2rayN.Views.TransportAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Приложения Transport" Width="525" Height="345" MinWidth="420" MinHeight="290"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Resources/VaKoLink.ico"
        Background="{DynamicResource PultCard}" Foreground="{DynamicResource PultText}">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/PultStyles.xaml" />
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Приложения Transport" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Добавьте подписанные EXE-файлы приложений, которые должны использовать Proxy через Transport."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource PultMuted}" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,6,0" Content="Сохранить" IsDefault="True" Click="Save_Click" Style="{StaticResource PultButton}" />
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource PultButton}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,6,0" Content="Добавить" Click="Add_Click" Style="{StaticResource PultButton}" />
                <Button Content="Убрать" Click="Remove_Click" Style="{StaticResource PultButton}" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="notice" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" />
        <ListBox x:Name="applications" SelectionMode="Extended" AutomationProperties.Name="Приложения Transport"
                 Background="{DynamicResource PultBackground}" Foreground="{DynamicResource PultText}" />
    </DockPanel>
</Window>
