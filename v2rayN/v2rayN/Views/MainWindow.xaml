<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="VaKoLink"
    Width="860"
    Height="610"
    MinWidth="680"
    MinHeight="550"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/VaKoLink.ico"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PultStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="SubscriptionChoiceButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Command" Value="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
        </Style>
        <DataTemplate x:Key="SubscriptionImportChoices">
            <StackPanel Width="300" Margin="24">
                <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="Добавить конфигурацию" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="Из буфера обмена" CommandParameter="Clipboard" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="QR-код" CommandParameter="Qr" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="Вручную" CommandParameter="Manual" />
                <Button HorizontalAlignment="Right" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="Отмена" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SubscriptionQrChoices">
            <StackPanel Width="300" Margin="24">
                <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="Импортировать QR-код" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="С экрана" CommandParameter="Screen" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="Из файла" CommandParameter="File" />
                <Button HorizontalAlignment="Right" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="Отмена" />
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <DockPanel Background="{DynamicResource PultBackground}" TextElement.Foreground="{DynamicResource PultText}">
                <Border DockPanel.Dock="Top" Padding="19,10" Background="{DynamicResource PultHeader}" BorderBrush="{DynamicResource PultOutline}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="updateProgressPanel" Width="145" Margin="0,0,12,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="updatePercent" FontWeight="SemiBold" TextAlignment="Right" />
                                <TextBlock x:Name="updateStage" Opacity="0.8" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                            </StackPanel>
                            <Button x:Name="checkUpdateButton" Margin="0,0,8,0"
                                    MinWidth="193"
                                    Style="{StaticResource PultButton}" Content="Проверить обновления" />
                            <Button x:Name="clientUpdateAction" Margin="0,0,8,0" MinWidth="100"
                                    Style="{StaticResource PultButton}" Content="Установить" Visibility="Collapsed" />
                            <Border Height="42" MinWidth="71" CornerRadius="10" Background="{DynamicResource PultControl}" BorderBrush="{DynamicResource PultControlOutline}" BorderThickness="1"><Menu HorizontalAlignment="Center" Background="Transparent" Foreground="{DynamicResource PultText}">
                                <MenuItem x:Name="mainMenu" Height="40" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" Header="Меню" FlowDirection="RightToLeft">
                                    <MenuItem Header="Импорт" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuAddServerViaClipboard" Header="Из буфера обмена" InputGestureText="Ctrl+V" />
                                        <MenuItem x:Name="menuAddServerViaScan" Header="QR с экрана" InputGestureText="Ctrl+S" />
                                        <MenuItem x:Name="menuAddServerViaImage" Header="QR из файла" />
                                    </MenuItem>
                                    <MenuItem Header="Подписки" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuSubSetting" Header="Управление подписками" />
                                        <MenuItem x:Name="menuSubUpdate" Header="Обновить подписки" />
                                        <MenuItem x:Name="menuSubUpdateViaProxy" Header="Обновить через Proxy" />
                                        <MenuItem x:Name="menuSubGroupUpdate" Header="Обновить текущую подписку" />
                                        <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="Обновить текущую через Proxy" />
                                    </MenuItem>
                                    <MenuItem Header="Настройки" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuOptionSetting" Header="Расширенные настройки" />
                                        <MenuItem x:Name="menuUpdateViaProxy" Header="Обновлять через прокси" IsCheckable="True" />
                                        <MenuItem x:Name="menuRoutingSetting" Header="Правила маршрутизации" />
                                        <MenuItem x:Name="menuDNSSetting" Header="DNS" />
                                        <MenuItem x:Name="menuGlobalHotkeySetting" Header="Горячие клавиши" />
                                        <MenuItem x:Name="menuTheme" Header="Оформление" />
                                        <MenuItem x:Name="menuBackupAndRestore" Header="Резервное копирование" />
                                        <MenuItem Header="Дополнительно">
                                            <MenuItem x:Name="menuOpenTheFileLocation" Header="Открыть папку данных" />
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="Справка" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuDiagnostics" Header="Диагностика" />
                                        <MenuItem x:Name="menuLog" Header="Журнал" />
                                        <MenuItem x:Name="menuAbout" Header="О программе" />
                                    </MenuItem>
                                </MenuItem>
                            </Menu></Border>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="configurationStatus" FontWeight="SemiBold" TextWrapping="Wrap" Text="Статус конфигурации — Нет данных" />
                            <TextBlock x:Name="configurationExpiry" Margin="0,2,0,0" Foreground="{DynamicResource PultMuted}"
                                       TextWrapping="Wrap" Text="Срок конфигурации — Нет данных" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl x:Name="contentStatusBarView" DockPanel.Dock="Bottom" />

                <Grid>
                    <Grid x:Name="connectionPage" Margin="24,22,24,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="290" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="13,16,13,12" Style="{StaticResource PultCardStyle}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="5,0,5,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="updateSubscriptionsButton" Width="91" Height="34" Margin="0,0,6,0" Padding="4,0"
                                                FontSize="12" Style="{StaticResource PultButton}" Content="Обновить"
                                                ToolTip="Обновить все включённые подписки без прокси" />
                                        <Button x:Name="measureLatencyButton" Width="96" Height="34" Padding="4,0"
                                                FontSize="12" Style="{StaticResource PultButton}" Content="Задержка ↻" Click="MeasureLatencyButton_Click"
                                                ToolTip="Измерить задержку всех нод" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="Ноды" />
                                </DockPanel>
                                <Grid>
                                    <ListBox x:Name="nodeList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                             ItemContainerStyle="{StaticResource PultNodeRow}" ItemTemplate="{StaticResource PultNode}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.Name="Ноды" />
                                    <StackPanel x:Name="emptyNodes" Margin="5,10,0,0">
                                        <TextBlock Foreground="{DynamicResource PultMuted}" Text="В профиле пока нет нод." TextWrapping="Wrap" />
                                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Click="AddConfigurationButton_Click"
                                                Style="{StaticResource PultButton}" Content="Добавить конфигурацию" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Margin="0,0,0,11" Padding="15,11,15,13" Style="{StaticResource PultCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0">
                                            <Button x:Name="refreshTrafficButton" HorizontalAlignment="Right" MinWidth="116" Height="32"
                                                    Padding="7,0" FontSize="12" Style="{StaticResource PultButton}" Content="Обновить расход" />
                                            <TextBlock x:Name="trafficFreshness" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource PultMuted}" FontSize="11"
                                                       MaxWidth="155" TextAlignment="Right" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Расход трафика" />
                                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run x:Name="trafficUsed" FontSize="20" FontWeight="SemiBold" Text="Нет данных" />
                                                <Run x:Name="trafficLimit" Foreground="{DynamicResource PultMuted}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar x:Name="trafficMeter" Margin="0,8,0,0" Height="4" Maximum="100"
                                                 Foreground="{DynamicResource PultAccent}" Background="{DynamicResource PultControl}"
                                                 AutomationProperties.Name="Доля использованного трафика" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="connectionCard" Padding="19,18,19,19" Style="{StaticResource PultCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,17">
                                        <Ellipse x:Name="connectionIndicator" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,7,0"
                                                 VerticalAlignment="Center" Fill="{DynamicResource PultMuted}" />
                                        <TextBlock x:Name="connectionStatus" Foreground="{DynamicResource PultMuted}" FontSize="14"
                                                   AutomationProperties.LiveSetting="Polite" Text="Отключено" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Margin="0,0,0,17" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource PultNodeLabel}, ConverterParameter=Country}"
                                               x:Name="selectedNodeName" />
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel x:Name="connectionTimerPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                            <Path Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"
                                                  Stroke="{Binding Foreground, ElementName=connectionTimer}"
                                                  Data="M 6,1 A 5,5 0 1 1 5.99,1 Z M 6,3 L 6,6 L 8,6" />
                                            <TextBlock x:Name="connectionTimer" FontFamily="Consolas" FontSize="12"
                                                       AutomationProperties.Name="Время подключения" />
                                        </StackPanel>
                                        <TextBlock FontSize="14" Text="Режим" />
                                    </DockPanel>
                                    <Border Padding="3" Height="42" CornerRadius="9" Background="{DynamicResource PultModeTrack}">
                                        <UniformGrid Rows="1" Columns="2">
                                            <RadioButton x:Name="modeProxy" Style="{StaticResource PultMode}" GroupName="VaKoLinkMode" Content="Proxy" />
                                            <RadioButton x:Name="modeTun" Style="{StaticResource PultMode}" GroupName="VaKoLinkMode" Content="TUN" />
                                        </UniformGrid>
                                    </Border>
                                    <Button x:Name="connectionButton" Margin="0,10,0,0" Height="42" FontWeight="SemiBold"
                                            Style="{StaticResource PultButton}" Content="Подключить" />
                                    <TextBlock x:Name="connectionNotice" Margin="0,9,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource PultMedium}" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="transportCard" Margin="0,11,0,0" Padding="15,12" Style="{StaticResource PultCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Transport" />
                                        <TextBlock x:Name="transportStatus" Margin="0,3,0,0" Foreground="{DynamicResource PultMuted}"
                                                   AutomationProperties.LiveSetting="Polite" Text="Остановлен" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="transportButton" Grid.Column="1" VerticalAlignment="Center" MinWidth="98"
                                            AutomationProperties.Name="Управление Transport" Style="{StaticResource PultButton}" Content="Запустить" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <DockPanel x:Name="advancedPage" Margin="24,18,24,16" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button x:Name="backButton" DockPanel.Dock="Right"
                                    Style="{StaticResource PultButton}" Content="К подключению" />
                            <TextBlock x:Name="advancedTitle" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid>
                            <ContentControl x:Name="logHost" Visibility="Collapsed" />
                            <ContentControl x:Name="themeHost" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                    <materialDesign:Snackbar x:Name="MainSnackbar" MessageQueue="{materialDesign:MessageQueue}" />
                </Grid>
            </DockPanel>
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
