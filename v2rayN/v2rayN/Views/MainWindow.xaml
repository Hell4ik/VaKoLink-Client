<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="VaKoLink"
    Width="940"
    Height="640"
    MinWidth="680"
    MinHeight="520"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/v2rayN.ico"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SubscriptionChoiceButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Command" Value="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
        </Style>
        <DataTemplate x:Key="SubscriptionImportChoices">
            <StackPanel Width="300" Margin="24">
                <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="Добавить подписку" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="Из буфера обмена" CommandParameter="Clipboard" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="QR-код" CommandParameter="Qr" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="Вручную" CommandParameter="Manual" />
                <Button HorizontalAlignment="Right" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="Отмена" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SubscriptionQrChoices">
            <StackPanel Width="300" Margin="24">
                <TextBlock Margin="0,0,0,16" FontSize="20" FontWeight="SemiBold" Text="Импортировать QR-код" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="С экрана" CommandParameter="Screen" />
                <Button Style="{StaticResource SubscriptionChoiceButton}" Content="Из файла" CommandParameter="File" />
                <Button HorizontalAlignment="Right" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Content="Отмена" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <DockPanel>
                <materialDesign:ColorZone DockPanel.Dock="Top" Mode="Standard" Padding="24,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="updateProgressPanel" Width="194" Margin="0,0,12,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="updatePercent" FontWeight="SemiBold" TextAlignment="Right" />
                                <TextBlock x:Name="updateStage" Opacity="0.8" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                            </StackPanel>
                            <Button x:Name="checkUpdateButton" Margin="0,0,14,0"
                                    MinWidth="198"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Content="Проверить обновления" />
                            <Menu VerticalAlignment="Center" Background="Transparent">
                                <MenuItem x:Name="mainMenu" Padding="14,8" Header="Меню" FlowDirection="RightToLeft">
                                    <MenuItem Header="Импорт" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuAddServerViaClipboard" Header="Из буфера обмена" InputGestureText="Ctrl+V" />
                                        <MenuItem x:Name="menuAddServerViaScan" Header="QR с экрана" InputGestureText="Ctrl+S" />
                                        <MenuItem x:Name="menuAddServerViaImage" Header="QR из файла" />
                                    </MenuItem>
                                    <MenuItem Header="Подписки" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuSubSetting" Header="Управление подписками" />
                                        <MenuItem x:Name="menuSubUpdate" Header="Обновить подписки" />
                                        <MenuItem x:Name="menuSubUpdateViaProxy" Header="Обновить через Proxy" />
                                        <MenuItem x:Name="menuSubGroupUpdate" Header="Обновить текущую подписку" />
                                        <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="Обновить текущую через Proxy" />
                                    </MenuItem>
                                    <MenuItem Header="Настройки" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuOptionSetting" Header="Расширенные настройки" />
                                        <MenuItem x:Name="menuUpdateViaProxy" Header="Обновлять через прокси" IsCheckable="True" />
                                        <MenuItem x:Name="menuRoutingSetting" Header="Правила маршрутизации" />
                                        <MenuItem x:Name="menuDNSSetting" Header="DNS" />
                                        <MenuItem x:Name="menuGlobalHotkeySetting" Header="Горячие клавиши" />
                                        <MenuItem x:Name="menuTheme" Header="Оформление" />
                                        <MenuItem x:Name="menuBackupAndRestore" Header="Резервное копирование" />
                                        <MenuItem Header="Дополнительно">
                                            <MenuItem x:Name="menuOpenTheFileLocation" Header="Открыть папку данных" />
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="Справка" FlowDirection="LeftToRight">
                                        <MenuItem x:Name="menuLog" Header="Журнал" />
                                        <MenuItem x:Name="menuAbout" Header="О программе" />
                                    </MenuItem>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <ContentControl x:Name="contentStatusBarView" DockPanel.Dock="Bottom" />

                <Grid>
                    <Grid x:Name="connectionPage" Margin="24,12,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="22" FontWeight="SemiBold" Text="Ноды" />
                            <Grid>
                                <ContentControl x:Name="profilesHost" Visibility="Collapsed" />
                                <StackPanel x:Name="emptyNodes" Margin="0,12,0,0">
                                    <TextBlock Opacity="0.8" Text="В профиле пока нет нод." />
                                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Click="AddSubscriptionButton_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Content="Добавить подписку" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>

                        <materialDesign:Card Grid.Row="1" Margin="0,12,0,0" Padding="16,12">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Режим" />
                                    <RadioButton x:Name="modeProxy" Margin="0,0,20,0" VerticalAlignment="Center"
                                                 GroupName="VaKoLinkMode" Content="Proxy" />
                                    <RadioButton x:Name="modeTun" Margin="0,0,24,0" VerticalAlignment="Center"
                                                 GroupName="VaKoLinkMode" Content="TUN" />
                                    <Button x:Name="connectionButton" MinWidth="144" Content="Подключить" />
                                </WrapPanel>
                                <TextBlock x:Name="connectionStatus" Margin="0,8,0,0"
                                           AutomationProperties.LiveSetting="Polite" Text="Отключено" TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Grid.Row="2" Margin="0,10,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock FontWeight="SemiBold" Text="Transport" />
                                    <TextBlock x:Name="transportStatus" Margin="0,4,0,0" Opacity="0.8"
                                               AutomationProperties.LiveSetting="Polite" Text="Transport остановлен" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="transportButton" Grid.Column="1" VerticalAlignment="Center" MinWidth="164"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Content="Запустить Transport" />
                            </Grid>
                        </materialDesign:Card>
                    </Grid>

                    <DockPanel x:Name="advancedPage" Margin="24,18,24,16" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button x:Name="backButton" DockPanel.Dock="Right"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Content="К подключению" />
                            <TextBlock x:Name="advancedTitle" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid>
                            <ContentControl x:Name="logHost" Visibility="Collapsed" />
                            <ContentControl x:Name="themeHost" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                    <materialDesign:Snackbar x:Name="MainSnackbar" MessageQueue="{materialDesign:MessageQueue}" />
                </Grid>
            </DockPanel>
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
