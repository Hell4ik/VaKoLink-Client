<Window
    x:Class="v2rayN.Views.UpdateReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VaKoLink"
    Width="490"
    MaxHeight="570"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Icon="/Resources/VaKoLink.ico"
    Background="{DynamicResource PultBackground}"
    Foreground="{DynamicResource PultText}">
    <Window.Resources>
        <ResourceDictionary Source="/Resources/PultStyles.xaml" />
    </Window.Resources>
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,16" FontSize="23" FontWeight="SemiBold" Text="Обновления" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="15,12" Style="{StaticResource PultCardStyle}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource PultMuted}" Text="ПРИЛОЖЕНИЕ" />
                        <TextBlock x:Name="appStatus" Margin="0,5,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="15,12" Style="{StaticResource PultCardStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource PultMuted}" Text="КОМПОНЕНТЫ" />
                        <ItemsControl x:Name="componentRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{DynamicResource PultOutline}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold"
                                                       Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" FontSize="14" Foreground="{DynamicResource PultMuted}"
                                                       Text="{Binding Status}" TextAlignment="Right" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="noticeCard" Margin="0,12,0,0" Padding="15,11"
                        CornerRadius="10" Background="{DynamicResource PultSelected}">
                    <TextBlock x:Name="installNotice" FontSize="13" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Margin="0,16,0,0" MinWidth="110" HorizontalAlignment="Right"
                Style="{StaticResource PultButton}" IsDefault="True" IsCancel="True" Content="Понятно" />
    </Grid>
</Window>
